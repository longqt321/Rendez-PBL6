{$RENDEZ_SITE} {
	request_body {
		max_size 55MB
	}
	encode zstd gzip
	@django path /api/* /admin/* /public-photo-media/* /private-photo-media/* /private-photo-original/*
	handle @django {
		reverse_proxy 127.0.0.1:8000
	}
	handle_path /static/* {
		root * {$RENDEZ_STATIC_ROOT}
		file_server
	}
	handle {
		root * {$RENDEZ_FRONTEND_ROOT}
		try_files {path} /index.html
		file_server
	}
}
