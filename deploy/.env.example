# Production — copy ra /srv/rendez/.env và điền giá trị thật. KHÔNG commit.

NODE_ENV=production
PORT=8000

# Postgres — mật khẩu PHẢI khác mặc định dev (rendez_dev).
POSTGRES_USER=rendez
POSTGRES_PASSWORD=
POSTGRES_DB=rendez

# Origin của frontend (https, domain thật).
CORS_ORIGINS=https://rendez.example.com

# URL công khai của API — better-auth dùng để dựng link reset mật khẩu.
BETTER_AUTH_URL=https://rendez.example.com

# Secret phiên — tối thiểu 32 ký tự ngẫu nhiên:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Mức log production: info (đổi warn/error nếu quá ồn).
LOG_LEVEL=info

# IP tĩnh của Caddy trong mạng compose (xem deploy/compose.prod.yml).
TRUSTED_PROXIES=172.30.0.2

# Cloudflare R2 (bật upload ảnh). Thiếu → route media trả 503, phần còn lại chạy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# SMTP gửi mail quên mật khẩu (Resend/Brevo/SES…). Thiếu → không gửi được mail
# reset (API vẫn chạy). Hướng dẫn: docs/backend/SMTP-SETUP.md
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Phải thuộc domain đã xác minh, ví dụ: Rendez <no-reply@rendez.vn>
MAIL_FROM=
