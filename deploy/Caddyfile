# Caddy 2 — TLS tự động (Let's Encrypt) + reverse proxy tới API và FE tĩnh.
#
# Thay `rendez.example.com` bằng domain thật trước khi chạy.

rendez.example.com {
	# API: proxy vào service `api` trong mạng compose.
	handle /api/v1/* {
		reverse_proxy api:8000
	}

	# Health check cũng đi qua proxy để giám sát từ ngoài.
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}

	# ── OG preview cho bot mạng xã hội (xem docs/thiet-ke/chia-se-og-dong.md §6) ──
	# Bot FB/Zalo/Telegram… không chạy JS nên chỉ đọc meta tĩnh trong index.html.
	# Matcher dưới đây khớp UA bot đã biết + đúng path chi tiết, rồi rewrite sang
	# route OG của API để trả HTML meta động. Người dùng thật rơi xuống handle FE.
	# ĐẶT TRƯỚC handle tĩnh — Caddy xét `handle` theo thứ tự khai báo.
	@ogplace {
		path_regexp ogplace ^/discover/([^/]+)$
		# (?i) — UA không phân biệt hoa/thường (nginx dùng `~*` tương đương).
		header_regexp UA User-Agent (?i)(facebookexternalhit|facebot|facebookcatalog|meta-externalagent|meta-externalvalidator|zalo|twitterbot|slack|whatsapp|telegrambot|discordapp|linkedinbot)
	}
	handle @ogplace {
		rewrite * /api/v1/og/place/{re.ogplace.1}
		reverse_proxy api:8000
	}

	@ogpost {
		path_regexp ogpost ^/post/([^/]+)$
		header_regexp UA User-Agent (?i)(facebookexternalhit|facebot|facebookcatalog|meta-externalagent|meta-externalvalidator|zalo|twitterbot|slack|whatsapp|telegrambot|discordapp|linkedinbot)
	}
	handle @ogpost {
		rewrite * /api/v1/og/post/{re.ogpost.1}
		reverse_proxy api:8000
	}

	# File tĩnh có phần mở rộng: KHÔNG fallback về index.html — thiếu file phải
	# trả 404 thật (tránh soft-404 cho bundle cũ, manifest, ảnh hỏng). Tương ứng
	# `location ~* \.(...)$ { try_files $uri =404; }` của frontend/nginx.conf.
	@static_files {
		path *.js *.mjs *.css *.map *.json *.webmanifest *.txt *.xml *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.ico *.woff *.woff2 *.ttf *.otf
	}
	handle @static_files {
		root * /srv/web
		file_server
	}

	# Frontend: thư mục dist/ build bằng `bun run build` (Vite).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# SSE (`GET /api/v1/rooms/:code/events`): nén gzip sẽ đệm event làm stream
	# trễ/đứt — chỉ nén khi request KHÔNG phải SSE (D-056).
	@compressible {
		not path /api/v1/rooms/*/events
	}
	encode @compressible gzip

	# Header bảo mật cơ bản (API đã tự gắn một phần qua hono/secure-headers).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
