// Schema v1 — 18 bảng quan hệ (mục 4.1 của docs/backend/de-xuat-techstack-backend.md).
// `places.tags` là text[] (mục 4.2) nên KHÔNG có bảng place_tags.
// Chưa có ở v1 (thêm bằng migration ở phase tương ứng, đã ghi docs/BACKLOG.md):
//   - follows (T5.4)
//   - place_suggestion_notifications (T4.4)
//   - idempotency_keys (K2), rate_limits (H4), audit_logs (F3)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlaceCategory {
  cafe
  restaurant
  street_food @map("street-food")
  bakery
  dessert
  bar

  @@map("place_category")
}

enum PlaceStatus {
  open
  closed
  unknown

  @@map("place_status")
}

enum ReportReason {
  closed
  wrong_info @map("wrong-info")
  duplicate
  other

  @@map("report_reason")
}

enum ReportStatus {
  pending
  reviewed
  dismissed

  @@map("report_status")
}

enum NotificationType {
  place_suggestion @map("place-suggestion")
  like
  comment
  follow
  system

  @@map("notification_type")
}

enum RoomProposalKind {
  include
  exclude

  @@map("room_proposal_kind")
}

enum RoomProposalField {
  category
  district
  keyword
  price_max @map("priceMax")

  @@map("room_proposal_field")
}

enum RoomProposalStatus {
  open
  applied
  dismissed

  @@map("room_proposal_status")
}

enum UserRole {
  user
  moderator
  admin

  @@map("user_role")
}

// ---------------------------------------------------------------------------
// 1. users
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  handle          String    @unique
  email           String    @unique
  // better-auth dùng boolean `emailVerified`; xác thực email chưa bật (Phase 1).
  emailVerified   Boolean   @default(false) @map("email_verified")
  avatarUrl       String?   @map("avatar_url")
  coverUrl        String?   @map("cover_url")
  bio             String    @default("")
  location        String    @default("")
  privateProfile  Boolean   @default(false) @map("private_profile")
  role            UserRole  @default(user)
  bannedAt        DateTime? @map("banned_at")
  banReason       String?   @map("ban_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  accounts         Account[]
  sessions         Session[]
  posts            Post[]
  comments         Comment[]
  reviews          Review[]
  reports          PlaceReport[]
  postLikes        PostLike[]
  postSaves        PostSave[]
  commentLikes     CommentLike[]
  collections      Collection[]
  collectionLikes  CollectionLike[]
  notifications    Notification[]
  ownedRooms       Room[]         @relation("RoomOwner")
  roomMemberships  RoomMember[]
  following        Follow[]       @relation("Follower")
  followers        Follow[]       @relation("Following")
  idempotencyKeys  IdempotencyKey[]
  interactionEvents InteractionEvent[]
  auditLogs        AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// 1b. follows — quan hệ theo dõi (T5.4); tự theo dõi bị chặn ở tầng ứng dụng
// ---------------------------------------------------------------------------
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ---------------------------------------------------------------------------
// 2. sessions
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // better-auth quản lý token phiên (không hash — xem DECISIONS 2026-11-11).
  token     String   @unique
  ip        String?
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// 2b. accounts — bảng của better-auth (email+password lưu hash ở đây)
// ---------------------------------------------------------------------------

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// 2c. verifications — token xác thực email/reset (better-auth)
// ---------------------------------------------------------------------------

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// 3. places — đủ 23 cột dataset + trường nội bộ (F1/F2/F3)
// ---------------------------------------------------------------------------

model Place {
  id           String        @id
  name         String
  address      String
  city         String        @default("Đà Nẵng")
  district     String?
  category     PlaceCategory
  // 1–3 (hợp đồng API). Ràng buộc CHECK nằm ở migration
  // 20261111110000_places_price_level_check — Prisma không mô hình hoá CHECK.
  priceLevel   Int           @default(1) @map("price_level")
  lat          Float?
  lng          Float?
  status       PlaceStatus   @default(unknown)

  // Nội dung dataset — không trả API ở Phase 0 (F1)
  description  String?
  phone        String?
  openingHours String?       @map("opening_hours")
  geoSource    String?       @map("geo_source")
  geoPrecision String?       @map("geo_precision")
  venuePageUrl String?       @map("venue_page_url")
  verified     Boolean       @default(false)
  collectedAt  DateTime?     @map("collected_at")
  tier         String?
  osmId        String?       @map("osm_id")
  imageKind    String?       @map("image_kind")
  imageNote    String?       @map("image_note")

  // Duyệt / kiểm duyệt (F2/F3)
  publishedAt      DateTime? @map("published_at")
  moderationStatus String?   @map("moderation_status")
  moderatedBy      String?   @map("moderated_by") @db.Uuid
  moderatedAt      DateTime? @map("moderated_at")
  moderationNote   String?   @map("moderation_note")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  images          PlaceImage[]
  placeTags       PlaceTag[]
  placeSources    PlaceSource[]
  reviews         Review[]
  reports         PlaceReport[]
  posts           Post[]
  collectionItems CollectionPlace[]
  dailyPicks      DailyPick[]
  embeddings      PlaceEmbedding[]
  interactionEvents InteractionEvent[]
  affinityCache   AffinityCache?

  @@index([publishedAt, status])
  @@index([lat, lng])
  @@index([category])
  @@index([district])
  @@map("places")
}

// ---------------------------------------------------------------------------
// 3b. tags & place_tags (tách khỏi Place.tags[] để đạt chuẩn 3NF)
// ---------------------------------------------------------------------------

model Tag {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  places    PlaceTag[]

  @@map("tags")
}

model PlaceTag {
  placeId  String @map("place_id")
  tagId    String @map("tag_id") @db.Uuid
  position Int    @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
  @@index([tagId, placeId])
  @@index([placeId, position])
  @@map("place_tags")
}

// ---------------------------------------------------------------------------
// 3c. sources & place_sources (tách khỏi Place.sources[] để đạt chuẩn 3NF)
// ---------------------------------------------------------------------------

model Source {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique
  createdAt DateTime      @default(now()) @map("created_at")
  places    PlaceSource[]

  @@map("sources")
}

model PlaceSource {
  placeId  String @map("place_id")
  sourceId String @map("source_id") @db.Uuid

  place  Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([placeId, sourceId])
  @@index([sourceId, placeId])
  @@map("place_sources")
}

// ---------------------------------------------------------------------------
// 4. place_images
// ---------------------------------------------------------------------------

model PlaceImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId   String   @map("place_id")
  url       String
  height    Int      @default(320)
  credit    String?
  kind      String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, position])
  @@map("place_images")
}

// ---------------------------------------------------------------------------
// 5. reviews — 1 user 1 review/place (upsert, A7.4)
// ---------------------------------------------------------------------------

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId   String    @map("place_id")
  authorId  String    @map("author_id") @db.Uuid
  rating    Int
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  place  Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([placeId, authorId])
  @@index([placeId, createdAt])
  @@index([authorId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// 6. place_reports — dữ liệu kiểm duyệt, không có GET (A7.5)
// ---------------------------------------------------------------------------

model PlaceReport {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId    String       @map("place_id")
  reporterId String       @map("reporter_id") @db.Uuid
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(pending)
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  place    Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([placeId, reason, reporterId])
  @@index([status, createdAt])
  @@map("place_reports")
}

// ---------------------------------------------------------------------------
// 7. posts
// ---------------------------------------------------------------------------

model Post {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  placeId   String?   @map("place_id")
  caption   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  place    Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]
  images   PostImage[]
  suggestionNotice PlaceSuggestionNotification?
  interactionEvents InteractionEvent[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([placeId])
  @@map("posts")
}

// ---------------------------------------------------------------------------
// 7b. post_images — ảnh người dùng tải lên qua presigned URL (G5b)
// ---------------------------------------------------------------------------

model PostImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_images")
}

// ---------------------------------------------------------------------------
// 8. post_likes
// ---------------------------------------------------------------------------

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// ---------------------------------------------------------------------------
// 9. post_saves
// ---------------------------------------------------------------------------

model PostSave {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_saves")
}

// ---------------------------------------------------------------------------
// 10. comments — lồng tối đa 1 cấp, xoá mềm (A7.6)
// ---------------------------------------------------------------------------

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, parentId, createdAt])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// 11. comment_likes
// ---------------------------------------------------------------------------

model CommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

// ---------------------------------------------------------------------------
// 12. collections
// ---------------------------------------------------------------------------

model Collection {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  name        String
  description String    @default("")
  isPrivate   Boolean   @default(false) @map("is_private")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionPlace[]
  likes CollectionLike[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("collections")
}

// ---------------------------------------------------------------------------
// 13. collection_places — position giữ thứ tự thêm (A7.7)
// ---------------------------------------------------------------------------

model CollectionPlace {
  collectionId String   @map("collection_id") @db.Uuid
  placeId      String   @map("place_id")
  position     Int      @default(0)
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([collectionId, placeId])
  @@index([collectionId, position])
  @@map("collection_places")
}

// ---------------------------------------------------------------------------
// 14. collection_likes
// ---------------------------------------------------------------------------

model CollectionLike {
  collectionId String   @map("collection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
  @@map("collection_likes")
}

// ---------------------------------------------------------------------------
// 15. rooms — filter là JSONB (mục 4.2)
// ---------------------------------------------------------------------------

model Room {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  filter    Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User           @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   RoomMember[]
  proposals RoomProposal[]

  @@map("rooms")
}

// ---------------------------------------------------------------------------
// 16. room_members — guest không cần tài khoản (D5)
// ---------------------------------------------------------------------------

model RoomMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  isGuest     Boolean  @default(true) @map("is_guest")
  /// HMAC-SHA256(token, BETTER_AUTH_SECRET) — token gốc chỉ nằm trong cookie
  /// HttpOnly theo phòng, trả về đúng một lần khi join (D-056).
  tokenHash   String?  @unique @map("token_hash")
  /// Mốc hoạt động gần nhất — dọn token quá 24h không dùng khi load phòng.
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  joinedAt    DateTime @default(now()) @map("joined_at")

  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  proposals RoomProposal[]

  @@index([roomId])
  @@map("room_members")
}

// ---------------------------------------------------------------------------
// 17. room_proposals — status do server quyết định (F2)
// ---------------------------------------------------------------------------

model RoomProposal {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String             @map("room_id") @db.Uuid
  memberId  String             @map("member_id") @db.Uuid
  kind      RoomProposalKind
  field     RoomProposalField
  value     String
  status    RoomProposalStatus @default(open)
  /// Ai áp đề xuất vào filter (CAS apply — updateMany where status=open).
  appliedBy String?            @map("applied_by") @db.Uuid
  appliedAt DateTime?          @map("applied_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  room   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member RoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@map("room_proposals")
}

// ---------------------------------------------------------------------------
// 18. notifications — payload JSONB theo kind (mục 4.2)
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestionNotice PlaceSuggestionNotification?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 18b. place_suggestion_notifications — idempotence job A7.2 (1 post 1 lần)
// ---------------------------------------------------------------------------

model PlaceSuggestionNotification {
  postId         String   @id @map("post_id") @db.Uuid
  notificationId String   @unique @map("notification_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("place_suggestion_notifications")
}

// ---------------------------------------------------------------------------
// 19. rate_limits — đếm theo cửa sổ thời gian, không cần Redis (H4)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 20. idempotency_keys — replay response cho mutation quan trọng (K2)
// ---------------------------------------------------------------------------

model IdempotencyKey {
  key            String   @db.VarChar(64)
  userId         String   @map("user_id") @db.Uuid
  /// SHA-256 của body request — key dùng lại với payload khác → 422.
  requestHash    String   @map("request_hash") @db.VarChar(64)
  /// `pending` khi đang xử lý (request thứ hai cùng key → 409) | `completed`.
  status         String   @default("pending")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([key, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// 21. daily_picks — "Gợi ý hôm nay": 3 quán mỗi ngày (Daily Picks)
// ---------------------------------------------------------------------------

model DailyPick {
  id        String   @id @default(uuid()) @db.Uuid
  /// Ngày theo Asia/Ho_Chi_Minh — job tính bằng `pickDate` chứ không dùng now().
  pickDate  DateTime @map("pick_date") @db.Date
  /// 1..3 — thứ tự hiển thị trên dải gợi ý.
  position  Int
  placeId   String   @map("place_id")
  place     Place    @relation(fields: [placeId], references: [id])
  /// Lý do ngắn do job dựng từ dữ liệu thật ("Quán mới", "Nhiều đánh giá"…).
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  /// Idempotence: 3 slot/ngày — job chạy lại không nhân đôi slot.
  @@unique([pickDate, position])
  /// Bất biến nghiệp vụ: một quán không xuất hiện 2 lần trong cùng ngày.
  @@unique([pickDate, placeId])
  @@map("daily_picks")
}

// ---------------------------------------------------------------------------
// 22. place_embeddings — vector e5-small cho hybrid search + content-based rec
// (migration 20261113080000). Field `embedding` là `Unsupported`: Prisma KHÔNG
// trả field này qua model API — mọi thao tác vector phải dùng `$queryRaw`.
// ---------------------------------------------------------------------------

model PlaceEmbedding {
  placeId     String   @id @map("place_id")
  place       Place    @relation(fields: [placeId], references: [id])
  model       String
  dim         Int
  /// vector(384) — chỉ đọc/ghi qua `$queryRaw` (đã kiểm chứng, C mục 6).
  embedding   Unsupported("vector(384)")?
  contentHash String   @map("content_hash")
  embeddedAt  DateTime @default(now()) @map("embedded_at")

  @@map("place_embeddings")
}

// ---------------------------------------------------------------------------
// 23. interaction_events — log hành vi append-only, partition theo tháng
// (migration 20261113080000). Nguồn học duy nhất cho affinity/ALS/eval;
// UI hiển thị vẫn đọc các bảng nghiệp vụ (post_likes…), KHÔNG đọc bảng này.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 24. affinity_cache — item-item affinity tính sẵn (migration 20261113100000).
// `related` là mảng JSON [{ id, score }] do job `refreshAffinityCache` ghi —
// KHÔNG mô hình hoá từng item thành bảng con: chỉ đọc nguyên khối theo place.
// ---------------------------------------------------------------------------

model AffinityCache {
  placeId    String   @id @map("place_id")
  place      Place    @relation(fields: [placeId], references: [id])
  related    Json     @default("[]")
  computedAt DateTime @default(now()) @map("computed_at")

  @@map("affinity_cache")
}

model InteractionEvent {
  /// Partitioned PK phải gồm cột partition (created_at).
  id         BigInt   @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  anonId     String?  @map("anon_id")
  eventType  String   @map("event_type")
  placeId    String?  @map("place_id")
  place      Place?   @relation(fields: [placeId], references: [id])
  postId     String?  @map("post_id") @db.Uuid
  post       Post?    @relation(fields: [postId], references: [id])
  query      String?
  weight     Int
  context    Json     @default("{}")
  sessionId  String?  @map("session_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([placeId, eventType, createdAt(sort: Desc)])
  @@index([anonId, createdAt(sort: Desc)])
  @@map("interaction_events")
}

// ---------------------------------------------------------------------------
// 25. audit_logs — nhật ký thao tác quản trị và sự kiện bảo mật
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([entity, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
