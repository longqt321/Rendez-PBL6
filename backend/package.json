{
  "name": "@rendez/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test-all.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed:dev": "SEED_MODE=dev bun run scripts/seed.ts",
    "db:seed:prod": "SEED_MODE=prod bun run scripts/seed.ts",
    "migrate": "prisma migrate dev",
    "seed": "bun run scripts/seed.ts",
    "db:studio": "prisma studio",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@huggingface/transformers": "4.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rendez/schema": "workspace:*",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.19",
    "cockatiel": "^4.0.0",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.53.2",
    "escape-html": "^1.0.3",
    "hdr-histogram-js": "^3.0.1",
    "hono": "4.13.17",
    "lru-cache": "^11.5.3",
    "maskdata": "^1.3.4",
    "nodemailer": "^10.5.0",
    "onnxruntime-node": "1.31.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "simple-statistics": "^8.0.0",
    "unstorage": "^2.0.0-beta.0",
    "votes": "^3.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/bun": "1.3.14",
    "@types/escape-html": "^1.0.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.16.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3"
  }
}
