# Backend API — chỉ khai TÊN biến, không commit giá trị thật.
# Copy sang .env rồi điền giá trị dev.

# development | test | production
NODE_ENV=development

# Cổng HTTP của API — khớp proxy dev của FE (VITE_PROXY_TARGET :8000)
PORT=8000

# Postgres 17 (docker compose up -d postgres)
# Runtime dùng URL này; migrate CLI đọc DATABASE_URL trực tiếp (Prisma 7).
DATABASE_URL=postgresql://rendez:rendez_dev@localhost:5432/rendez

# Origin được phép gọi API (phân tách bằng dấu phẩy) — phải khớp origin FE.
CORS_ORIGINS=http://localhost:5173

# Bí mật ký session của better-auth — BẮT BUỘC, tối thiểu 32 ký tự.
# Sinh: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL công khai của API (better-auth dùng để dựng callback URL).
BETTER_AUTH_URL=http://localhost:8000

# Origin frontend — đích redirect của link xác thực email (cũng là trustedOrigin).
APP_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# IP/CIDR của reverse proxy được tin cậy (phân tách bằng dấu phẩy). Để rỗng khi
# dev (API truy cập trực tiếp). Production đặt IP tĩnh của Caddy (xem deploy/).
TRUSTED_PROXIES=

# SMTP gửi mail quên mật khẩu (tuỳ chọn). Đủ 4 biến đầu + MAIL_FROM thì bật gửi
# mail thật; thiếu → dev log link reset ra log. Hướng dẫn: docs/backend/SMTP-SETUP.md
# Resend: host smtp.resend.com, port 465, user "resend", password = API key.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ From — phải thuộc domain đã xác minh ở nhà cung cấp.
MAIL_FROM=
