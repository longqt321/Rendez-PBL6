{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "predev": "node scripts/copy-cold-start-images.mjs",
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MOCKS=true vite",
    "prebuild": "node scripts/copy-cold-start-images.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "VITE_ENABLE_MOCKS=true VITE_DEV_BYPASS_AUTH=true VITE_MOCK_SCENARIO=ok playwright test",
    "e2e:ui": "playwright test --ui",
    "review:data": "node scripts/cold-start/review-server.mjs",
    "review:apply": "node scripts/cold-start/apply-review.mjs --apply",
    "pretest": "node scripts/check-image-variants.mjs",
    "check:image-variants": "node scripts/check-image-variants.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@formkit/auto-animate": "^0.10.2",
    "@hookform/resolvers": "^7.0.3",
    "@rendez/schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.106.1",
    "@uidotdev/usehooks": "2.4.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "cockatiel": "^4.0.0",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "leaflet.tilelayer.fallback": "^1.0.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
