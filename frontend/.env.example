# Base URL API mà trình duyệt gọi.
# Để "/api" để dùng proxy dev của Vite (khuyến nghị, không vướng CORS);
# đặt URL tuyệt đối nếu backend khác origin và đã cấu hình CORS.
VITE_API_BASE_URL=/api/v1

# Chỉ dùng ở dev server: đích thật của proxy "/api" (không lộ vào bundle client).
VITE_PROXY_TARGET=http://localhost:8000

# Bật mock server in-memory (src/mocks/) — "true" hoặc "false".
# Bỏ trống: dev bật, build production tắt. Khi backend thật sẵn sàng đặt "false".
VITE_ENABLE_MOCKS=

# Bỏ qua đăng nhập ở dev (mock tự trả user giả cho GET /me) — "true" hoặc "false".
# Bỏ trống: bật. Đặt "false" để thấy trạng thái chưa đăng nhập (mock trả 401).
# Chỉ có ý nghĩa khi mock bật.
VITE_DEV_BYPASS_AUTH=

# Kịch bản lỗi của mock server — chỉ có ý nghĩa khi mock bật.
# ok | slow | empty | server-error | unauthorized | offline
# Bỏ trống: ok. Đổi giá trị cần restart dev server.
# slow/empty/server-error/unauthorized chỉ áp dụng cho GET; offline áp mọi method.
VITE_MOCK_SCENARIO=
