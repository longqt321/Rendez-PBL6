{
  "version": 8,
  "name": "Đà Nẵng · Rendez",
  "sources": {
    "esri-street": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
        "https://services.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Tiles © <a href=\"https://www.esri.com/\">Esri</a> — Sources: Esri, OpenStreetMap contributors"
    },
    "danang": {
      "type": "geojson",
      "data": "/map/region.geojson",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f3f0e8"
      }
    },
    {
      "id": "esri-tiles",
      "type": "raster",
      "source": "esri-street",
      "minzoom": 0,
      "maxzoom": 19
    },
    {
      "id": "street-names",
      "type": "symbol",
      "source": "danang",
      "minzoom": 14,
      "filter": [
        "all",
        ["==", ["get", "kind"], "road"],
        ["!=", ["get", "name"], ""]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-angle": 30,
        "symbol-spacing": 350
      },
      "paint": {
        "text-color": "#1f382b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ],
  "glyphs": "/map/glyphs/{fontstack}/{range}.pbf"
}
