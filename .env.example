# Rendez Configuration Template (.env.example)
# Copy to .env for local development or deploy environment.
# DO NOT commit actual secrets or production credentials into git.

# [Security]
# DJANGO_DEBUG: 1 for local development, 0 for production.
DJANGO_DEBUG=1

# DJANGO_SECRET_KEY: Required in production (DJANGO_DEBUG=0). Must be at least 32 characters.
# Generate a secure key using: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# DJANGO_SECRET_KEY=

# DJANGO_ALLOWED_HOSTS: Comma-separated allowed hostnames/IPs. Required when DJANGO_DEBUG=0.
# Wildcards (*) are strictly rejected in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DJANGO_CSRF_TRUSTED_ORIGINS: Comma-separated trusted origins for CSRF protection.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DJANGO_HTTPS: 1 to enforce HTTPS session and CSRF cookie security flags, 0 for HTTP dev.
DJANGO_HTTPS=0

# [Database]
# Local development defaults to rendez-local; production requires setting POSTGRES_PASSWORD.
POSTGRES_DB=rendez
POSTGRES_USER=rendez
POSTGRES_PASSWORD=rendez-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# [Frontend]
VITE_MAP_STYLE=/map/style.json
