# Base URL API mà trình duyệt gọi.
# Để "/api" để dùng proxy dev của Vite (khuyến nghị, không vướng CORS);
# đặt URL tuyệt đối nếu backend khác origin và đã cấu hình CORS.
VITE_API_BASE_URL=/api

# Chỉ dùng ở dev server: đích thật của proxy "/api" (không lộ vào bundle client).
VITE_PROXY_TARGET=http://localhost:8000

# Bật mock server in-memory (src/mocks/) — "true" hoặc "false".
# Bỏ trống: dev bật, build production tắt. Khi backend thật sẵn sàng đặt "false".
VITE_ENABLE_MOCKS=
