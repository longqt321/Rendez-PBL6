{
  "_note": "Nguồn duy nhất cho cụm cấm. Thêm luật mới vào đây, không sửa scripts/check-copy.mjs. Phrase so khớp không phân biệt hoa thường.",
  "extensions": [".tsx", ".jsx", ".ts", ".js", ".mjs", ".vue", ".svelte", ".html"],
  "scanRoots": ["frontend/src"],
  "skipDirs": ["node_modules", ".git", ".next", "dist", "build", "coverage", ".turbo"],
  "skipPathRegex": [
    "(^|/)(tests?|__tests__|e2e|fixtures?|seed|seeds|mocks?|stories)(/|$)",
    "\\.(test|spec|stories)\\.[a-z]+$"
  ],
  "regexRules": [
    {
      "id": "regex-not-x-but-y",
      "severity": "error",
      "pattern": "không phải[^.\\n]{1,80}?(—|–|-|,|;)\\s*mà (là|còn)",
      "flags": "i",
      "message": "Cấu trúc 'Không phải X mà là Y' bị cấm (VOICE.md luật 2). Xóa hoặc nói thẳng điều có thật."
    },
    {
      "id": "warn-eyebrow",
      "severity": "warn",
      "pattern": "eyebrow",
      "flags": "i",
      "message": "Eyebrow in hoa phía trên tiêu đề bị cấm (VOICE.md luật 4). Chỉ dùng nhãn in hoa để phân loại dữ liệu thật."
    },
    {
      "id": "warn-confirm-wordy",
      "severity": "warn",
      "pattern": "bạn có chắc chắn muốn",
      "flags": "i",
      "message": "Hộp thoại xác nhận nên ngắn: 'Đăng xuất?' kèm hai nút rõ nghĩa."
    }
  ],
  "phraseRules": [
    {
      "id": "phrase-legacy-copy",
      "severity": "error",
      "message": "Câu tagline/marketing đã bị gỡ khỏi Rendez (LESSONS L-001). Không đưa lại.",
      "phrases": [
        "tiếp tục nơi bạn đã dừng",
        "những nơi muốn quay lại",
        "nơi đáng để",
        "dành một buổi chiều",
        "sổ tay thành phố",
        "kinh nghiệm của cộng đồng",
        "do cộng đồng viết",
        "bộ sưu tập của bạn",
        "nơi bạn muốn ghé",
        "buổi tối dài",
        "đáng chụp lại",
        "đáng một chuyến đi",
        "khám phá thành phố qua",
        "một tài khoản để lưu"
      ]
    },
    {
      "id": "phrase-ai-stock",
      "severity": "error",
      "message": "Từ khuôn mẫu của văn AI/marketing (VOICE.md luật 1, 2).",
      "phrases": [
        "hành trình",
        "trải nghiệm trọn vẹn",
        "chạm đến",
        "dấu ấn",
        "dành riêng cho bạn",
        "những khoảnh khắc",
        "nâng tầm",
        "đánh thức"
      ]
    },
    {
      "id": "phrase-terminology",
      "severity": "error",
      "message": "Sai thuật ngữ cố định (VOICE.md mục 3).",
      "phrases": [
        "đăng trải nghiệm",
        "chia sẻ trải nghiệm",
        "hồ sơ của tôi",
        "lịch sử đăng ảnh",
        "đăng nhập trải nghiệm nhanh",
        "xem chi tiết không gian"
      ]
    },
    {
      "id": "phrase-generic-error",
      "severity": "error",
      "message": "Lỗi chung chung đi kèm lỗi cụ thể (UX_RULES mục 3). Chỉ giữ dòng cụ thể.",
      "phrases": ["kiểm tra lại thông tin đã nhập"]
    },
    {
      "id": "phrase-fixture-leak",
      "severity": "error",
      "message": "Chuỗi dữ liệu test lọt vào mã UI (UX_RULES mục 8).",
      "phrases": [
        "e2e demo",
        "— demo",
        "fixture phát triển",
        "giả để test",
        "lorem ipsum"
      ]
    },
    {
      "id": "phrase-english-leak",
      "severity": "warn",
      "message": "Chữ tiếng Anh mặc định của trình duyệt hoặc thư viện lọt vào UI tiếng Việt.",
      "phrases": ["choose files", "no file chosen"]
    }
  ]
}
