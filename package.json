{
  "name": "rendez",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": ["frontend", "backend", "packages/*"],
  "scripts": {
    "dev": "cd frontend && bun run dev",
    "dev:web": "cd frontend && bun run dev",
    "dev:api": "cd backend && bun run dev",
    "build": "cd frontend && bun run build",
    "build:api": "cd backend && bun run build",
    "typecheck": "cd frontend && bun run typecheck",
    "lint": "cd frontend && bun run lint",
    "format": "cd frontend && bun run format",
    "format:check": "cd frontend && bun run format:check",
    "test": "cd frontend && bun run test",
    "e2e": "cd frontend && bun run e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": ["prettier --write"],
    "frontend/**/*.{css,md,json}": ["prettier --write"],
    "backend/**/*.{ts,tsx,json}": ["prettier --write"]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
